### Fedora session integration
include /etc/sway/config.d/*
include /usr/share/sway/config.d/50-rules-*.conf
include /usr/share/sway/config.d/95-autostart-policykit-agent.conf
include /usr/share/sway/config.d/95-xdg-*.conf

### Variables
set $mod Mod4
set $alt Mod1

set $terminal foot
set $editor nvim
set $browser qutebrowser
set $file_manager thunar
set $hiddify ~/.local/bin/hiddify
set $helper ~/.config/sway/helper

set $left h
set $down j
set $up k
set $right l

### Appearance
font pango:monospace 10

default_border pixel 3
default_floating_border pixel 3

#                         border     background text       indicator  child border
client.focused            #e6dc9c    #0b0b0b    #f0f0f0    #e6dc9c    #e6dc9c
client.focused_inactive   #363635    #0b0b0b    #888888    #363635    #363635
client.unfocused          #0b0b0b    #0b0b0b    #888888    #0b0b0b    #0b0b0b
client.urgent             #900000    #900000    #f0f0f0    #900000    #900000

# output * bg ~/.local/share/backgrounds/wallpaper.jpg fill

### Input
input type:keyboard {
    xkb_layout "us,ir"
    xkb_options "caps:escape_shifted_capslock,grp:shifts_toggle"
    repeat_delay 200
    repeat_rate 50
}

input type:touchpad {
    dwt enabled
    tap enabled
}

seat * hide_cursor when-typing enable

### Session services
exec $helper wob
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

exec swayidle -w \
    timeout 300 '$helper lock' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '$helper lock' \
    lock '$helper lock' \
    unlock 'pkill -xu "$USER" -SIGUSR1 swaylock'

### Applications and session
bindsym --to-code --no-repeat $mod+d exec $helper launcher
bindsym --to-code --no-repeat $mod+Return exec $terminal
bindsym --to-code --no-repeat $mod+n exec $terminal $editor
bindsym --to-code --no-repeat $mod+i exec $browser
bindsym --to-code --no-repeat $mod+y exec $file_manager
bindsym --to-code --no-repeat $mod+p exec $hiddify
bindsym --to-code --no-repeat $mod+t exec Telegram

bindsym --to-code --no-repeat $mod+Shift+n exec $helper night
bindsym --to-code --no-repeat $mod+Shift+x exec $helper lock
bindsym --to-code --no-repeat $mod+Shift+e exec $helper power
bindsym --to-code --no-repeat $mod+Shift+c reload
bindsym --to-code --no-repeat $alt+q kill

floating_modifier $mod normal

### Focus and movement
bindsym --to-code $mod+$left focus left
bindsym --to-code $mod+$down focus down
bindsym --to-code $mod+$up focus up
bindsym --to-code $mod+$right focus right

bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right

bindsym --to-code $alt+$left workspace prev
bindsym --to-code $alt+$right workspace next

### Workspaces
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+0 workspace number 10

bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6
bindsym --to-code $mod+Shift+7 move container to workspace number 7
bindsym --to-code $mod+Shift+8 move container to workspace number 8
bindsym --to-code $mod+Shift+9 move container to workspace number 9
bindsym --to-code $mod+Shift+0 move container to workspace number 10

### Layout
bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv
bindsym --to-code $mod+s layout stacking
bindsym --to-code $mod+w layout tabbed
bindsym --to-code $mod+e layout toggle split
bindsym --to-code $mod+f fullscreen

bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+space focus mode_toggle
bindsym --to-code $mod+a focus parent

bindsym --to-code $mod+Shift+minus move scratchpad
bindsym --to-code $mod+minus scratchpad show

mode "resize" {
    bindsym --to-code $left resize shrink width 10px
    bindsym --to-code $down resize grow height 10px
    bindsym --to-code $up resize shrink height 10px
    bindsym --to-code $right resize grow width 10px
    bindsym --to-code Return mode "default"
    bindsym --to-code Escape mode "default"
}
bindsym --to-code $mod+r mode "resize"

### Clipboard and hardware keys
bindsym --to-code --no-repeat $mod+Ctrl+c exec $helper clipboard
bindsym --to-code --no-repeat $mod+Ctrl+Shift+c exec cliphist wipe

bindsym --locked XF86AudioRaiseVolume exec $helper volume up
bindsym --locked XF86AudioLowerVolume exec $helper volume down
bindsym --locked XF86AudioMute exec $helper volume mute
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

bindsym --locked XF86MonBrightnessDown exec $helper brightness down
bindsym --locked XF86MonBrightnessUp exec $helper brightness up

bindsym --no-repeat Print exec $helper screenshot save screen
bindsym --no-repeat Shift+Print exec $helper screenshot save area
bindsym --no-repeat Ctrl+Print exec $helper screenshot copy screen
bindsym --no-repeat Ctrl+Shift+Print exec $helper screenshot copy area

### Bar
bar {
    position top
    status_command $helper bar

    colors {
        statusline #f0f0f0
        background #0b0b0b
        focused_workspace  #275f94 #275f94 #f0f0f0
        active_workspace   #000000 #111111 #f0f0f0
        inactive_workspace #000000 #0a0a0a #888888
        urgent_workspace   #000000 #900000 #f0f0f0
    }
}
